# Copy this file to .env if needed.
# career-ai uses the claude CLI — no API key required.
#
# Install Claude Code CLI: https://claude.ai/download
# Then log in:  claude login
#
# No ANTHROPIC_API_KEY needed.

# Optional: override default config paths
# CAREER_AI_PROFILE=config/profile.yml
# CAREER_AI_PORTALS=config/portals.yml
